{
  "name": "bandal",
  "version": "0.84.5",
  "description": "Bandal (반달) — a study IDE for university students",
  "main": "./out/main/index.js",
  "author": "Bandal",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev": "node scripts/build-calendar.mjs && node scripts/build-browser-import.mjs && electron-vite dev",
    "marketplace:build": "vite build --config marketplace.vite.config.ts",
    "marketplace:start": "node out/marketplace/server.cjs",
    "marketplace:test": "node scripts/test-marketplace-local.mjs",
    "plugin:build": "vite build --config sdk.vite.config.ts",
    "plugin:test": "pnpm plugin:build && node scripts/test-plugin-sdk.mjs",
    "plugin": "pnpm plugin:build && node out/plugin-cli/plugin.cjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p web-demo/tsconfig.json",
    "deadcode": "knip --treat-config-hints-as-errors",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "dist": "electron-vite build && electron-builder --mac",
    "test": "vitest run --exclude \"e2e/**\"",
    "e2e": "electron-vite build && playwright test -c e2e",
    "generate-icon": "node scripts/generate-icon.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:unsigned": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg:arm64 -c.mac.notarize=false -c.mac.identity=null",
    "native:calendar": "node scripts/build-calendar.mjs",
    "build:web-demo": "node scripts/build-web-demo.mjs"
  },
  "dependencies": {
    "@fugood/whisper.node": "1.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@milkdown/core": "7.22.0",
    "@milkdown/ctx": "7.22.0",
    "@milkdown/exception": "7.22.0",
    "@milkdown/plugin-history": "7.22.0",
    "@milkdown/plugin-prism": "7.22.0",
    "@milkdown/preset-commonmark": "7.22.0",
    "@milkdown/preset-gfm": "7.22.0",
    "@milkdown/prose": "7.22.0",
    "@milkdown/react": "7.22.0",
    "@milkdown/transformer": "7.22.0",
    "@milkdown/utils": "7.22.0",
    "@mozilla/readability": "^0.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.62.1",
    "@silurus/ooxml": "0.86.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "better-sqlite3-node": "npm:better-sqlite3@^13.0.3",
    "canvas": "^3.2.3",
    "dockview": "^4.4.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "^3.1.0",
    "exceljs": "^4.4.0",
    "immer": "^10.1.1",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "katex": "0.18.1",
    "knip": "^6.34.0",
    "mammoth": "^1.12.1",
    "mdast-util-find-and-replace": "3.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "perfect-freehand": "^1.2.3",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.5.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typescript": "^5.8.3",
    "unist-util-visit": "5.1.0",
    "uuid": "^11.1.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zustand": "^5.0.5"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "@milkdown/core": "7.22.0",
      "@milkdown/ctx": "7.22.0",
      "@milkdown/utils": "7.22.0",
      "@milkdown/prose": "7.22.0",
      "@milkdown/transformer": "7.22.0",
      "@milkdown/exception": "7.22.0",
      "electron-builder-squirrel-windows": "26.15.7"
    },
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
