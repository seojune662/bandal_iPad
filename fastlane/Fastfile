default_platform(:ios)

platform :ios do
  private_lane :asc_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH") { File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8") }
    )
  end

  desc "Upload App Store metadata and screenshots only (no binary, no submission)"
  lane :metadata do
    asc_key
    deliver(app_identifier: "app.bandal.ipad", app_version: "1.1.0", skip_binary_upload: true,
            submit_for_review: false, run_precheck_before_submit: false, overwrite_screenshots: true, force: true)
  end

  desc "Upload screenshots only"
  lane :screenshots do
    asc_key
    deliver(app_identifier: "app.bandal.ipad", app_version: "1.1.0", skip_binary_upload: true, skip_metadata: true,
            submit_for_review: false, run_precheck_before_submit: false, overwrite_screenshots: true, force: true)
  end

  desc "Create or fetch the App Store provisioning profile with the API key"
  lane :profile do
    asc_key
    get_provisioning_profile(app_identifier: "app.bandal.ipad", team_id: "VUZ7Z98BW3", readonly: false, platform: "ios")
  end
end
