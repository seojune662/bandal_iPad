default_platform(:ios)

platform :ios do
  desc "Upload App Store metadata and screenshots only (no binary, no submission)"
  lane :metadata do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH") { File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8") }
    )
    deliver(
      app_identifier: "app.bandal.ipad",
      app_version: "1.0.0",
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      force: true
    )
  end
end
